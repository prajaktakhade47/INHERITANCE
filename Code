// Practical: Types of Inheritance in C++
#include <iostream>
using namespace std;

// 1. SINGLE INHERITANCE: Animal -> Dog
class Animal {
public:
    void eat() { cout << "Animal can eat" << endl; }
};
class Dog : public Animal {
public:
    void bark() { cout << "Dog can bark" << endl; }
};

// 2. MULTILEVEL INHERITANCE: Animal -> Mammal -> Cat
class Mammal : public Animal {
public:
    void feedMilk() { cout << "Mammal feeds milk to babies" << endl; }
};
class Cat : public Mammal {
public:
    void meow() { cout << "Cat can meow" << endl; }
};

// 3. MULTIPLE INHERITANCE: Father + Mother -> Child
class Father {
public:
    void height() { cout << "Child gets height from Father" << endl; }
};
class Mother {
public:
    void color() { cout << "Child gets eye color from Mother" << endl; }
};
class Child : public Father, public Mother { };

// 4. HIERARCHICAL INHERITANCE: Vehicle -> Car, Bike
class Vehicle {
public:
    void start() { cout << "Vehicle started" << endl; }
};
class Car : public Vehicle {
public:
    void wheels() { cout << "Car has 4 wheels" << endl; }
};
class Bike : public Vehicle {
public:
    void wheels() { cout << "Bike has 2 wheels" << endl; }
};

// 5. HYBRID INHERITANCE: Person -> Student, Employee -> TeachingAssistant
// 'virtual' keeps only one copy of Person (solves the diamond problem)
class Person {
public:
    void showPerson() { cout << "I am a Person" << endl; }
};
class Student : virtual public Person {
public:
    void study() { cout << "I study" << endl; }
};
class Employee : virtual public Person {
public:
    void work() { cout << "I work" << endl; }
};
class TeachingAssistant : public Student, public Employee { };

int main() {
    cout << "--- Single Inheritance ---" << endl;
    Dog d;
    d.eat();
    d.bark();

    cout << "\n--- Multilevel Inheritance ---" << endl;
    Cat c;
    c.eat();
    c.feedMilk();
    c.meow();

    cout << "\n--- Multiple Inheritance ---" << endl;
    Child ch;
    ch.height();
    ch.color();

    cout << "\n--- Hierarchical Inheritance ---" << endl;
    Car car;
    Bike bike;
    car.start();
    car.wheels();
    bike.start();
    bike.wheels();

    cout << "\n--- Hybrid Inheritance ---" << endl;
    TeachingAssistant ta;
    ta.showPerson();
    ta.study();
    ta.work();

    return 0;
}
